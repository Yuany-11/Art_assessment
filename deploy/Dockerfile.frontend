# ============================================================================
# 前端多阶段构建镜像
# 用 npm 代替 pnpm，避开 pnpm workspace 兼容坑
# ============================================================================
FROM node:20-alpine AS builder

WORKDIR /build

# 用淘宝 npm 镜像加速 + npm ci 严格安装
# 先看有没有 workspace，没有就直接 npm install
COPY package.json ./
RUN npm config set registry https://registry.npmmirror.com && \
    npm install --no-audit --no-fund

COPY . .
RUN npm run build

# --- 生产镜像是 nginx:alpine 里只装产物 ---
FROM nginx:1.24-alpine

COPY --from=builder /build/dist /var/www/frontend
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
