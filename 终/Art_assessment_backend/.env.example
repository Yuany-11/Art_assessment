# ==================== Django ====================
DJANGO_SECRET_KEY=replace-with-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------- MySQL ----------
DB_NAME=art_assessment
DB_USER=art
DB_PASSWORD=art_pass
DB_HOST=127.0.0.1
DB_PORT=3307

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0
# redis | locmem（无 Redis 环境时用于本地调试）
CACHE_BACKEND=redis

# ---------- JWT ----------
JWT_SECRET=replace-with-another-random-string
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# ---------- MinIO ----------
FILE_STORAGE=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=art-assessment
MINIO_USE_SSL=false
MINIO_PRESIGN_EXPIRES=300

# ---------- Demo 数据 ----------
DEMO_PASSWORD=Demo@123456
