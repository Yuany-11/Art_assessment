# ==================== Django ====================
DJANGO_SECRET_KEY=replace-with-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 本地演示默认值 ====================
# 本文件按“本地 SQLite + 进程内缓存 + 本地文件”配置，复制为 .env 即可直接运行。
DB_ENGINE=sqlite

# 如需 MySQL：把 DB_ENGINE 改为 mysql，并填写下列连接信息
DB_NAME=art_assessment
DB_USER=art
DB_PASSWORD=art_pass
DB_HOST=127.0.0.1
DB_PORT=3307

# 缓存：locmem（本地，无需 Redis）| redis
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/0

# 文件存储：local（落盘到 backend/media/）| minio
FILE_STORAGE=local
# 使用 MinIO 时填写：
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=art-assessment
# MINIO_USE_SSL=false
# MINIO_PRESIGN_EXPIRES=300

# ---------- JWT ----------
JWT_SECRET=replace-with-another-random-string
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# ---------- 邮件（注册验证码） ----------
# 默认 console：验证码打印在后端启动终端，不真实发信。
# 配置 SMTP 后改为：EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=艺术素质测评系统 <no-reply@example.com>

# ---------- Demo 数据 ----------
# 演示账号统一密码，seed_demo_accounts / seed_classes 会使用该值
DEMO_PASSWORD=Demo@123456
