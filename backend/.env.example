# ==================== Django ====================
DJANGO_SECRET_KEY=replace-with-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 本地演示默认值 ====================
# 本文件按“本地 SQLite + 进程内缓存 + 本地文件”配置，复制为 .env 即可直接运行。
DB_ENGINE=sqlite

# 如需 MySQL：把 DB_ENGINE 改为 mysql，并填写下列连接信息
DB_NAME=art_assessment
DB_USER=art
DB_PASSWORD=art_pass
DB_HOST=127.0.0.1
DB_PORT=3307

# 缓存：locmem（本地，无需 Redis）| redis
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/0

# 文件存储：local（落盘到 backend/media/）| minio
FILE_STORAGE=local
# 使用 MinIO 时填写：
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=art-assessment
# MINIO_USE_SSL=false
# MINIO_PRESIGN_EXPIRES=300

# ---------- 音频标签模型（arteval-v4） ----------
# 关闭后上传、组卷、评分等功能不受影响，只是不展示音频标签。
AUDIO_TAGGER_ENABLED=true
AUDIO_TAGGER_URL=http://127.0.0.1:8100
AUDIO_TAGGER_TIMEOUT=120
# 音乐 AI 建议分（参考分按题目满分折算，仅作建议）
AI_SCORE_SUGGESTION_ENABLED=true
AI_SCORE_CONFIDENCE_THRESHOLD=0.4
AI_SCORE_SOURCE_MAX=100
# 美术作品 AI 辅助评分：未配置 ART_SCORER_URL 时用规则式降级（degraded=true）
ART_SCORER_ENABLED=true
ART_SCORER_URL=
ART_SCORER_TIMEOUT=60
ART_SCORER_CONFIDENCE_THRESHOLD=0.6

# ---------- 美术出题模型（Model B / 云 API）----------
# 默认关闭；只有打开开关且配置了可用后端后才允许在线生成。离线导入不需要它。
QGEN_ENABLED=false
# model_b：调用本地 8002 服务；api：调用兼容 OpenAI 的云接口
QGEN_PROVIDER=model_b
QGEN_URL=http://127.0.0.1:8002
QGEN_TIMEOUT=90
QGEN_TOKEN=
# 图题：默认请求模型优先生成带配图的题；无同题型素材时服务自动退回文字题
QGEN_WITH_IMAGE=true
# 模型服务配图 URL 前缀与下载限制（后端只从 QGEN_URL/该前缀下载，图片落入本地 media）
QGEN_RESOURCE_URL_BASE=/resources
QGEN_RESOURCE_TIMEOUT=30
QGEN_RESOURCE_MAX_BYTES=10485760

# 云 API 模式（QGEN_PROVIDER=api）时填写；密钥只放 .env，不要提交到仓库
# 示例：DeepSeek https://api.deepseek.com/v1 + deepseek-chat
# 示例：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
QGEN_API_BASE=
QGEN_API_KEY=
QGEN_API_MODEL=
QGEN_API_TIMEOUT=60
QGEN_API_TEMPERATURE=0.7
# 可选：题卡 jsonl 与单元映射文件路径，留空使用默认值
QGEN_BANK_PATH=
QGEN_UNIT_MAP_PATH=
QGEN_NEAR_DUPLICATE=0.9

# ---------- JWT ----------
JWT_SECRET=replace-with-another-random-string
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# ---------- Demo 数据 ----------
# 演示账号统一密码，seed_demo_accounts / seed_classes 会使用该值
DEMO_PASSWORD=Demo@123456
